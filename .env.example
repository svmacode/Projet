# Copie ce fichier en `.env` puis adapte les valeurs. Le fichier .env ne doit jamais être publié.

# Ports locaux
PORT=8080
HTTPS_PORT=8443

# Adresse publique du site (utilisée pour le sitemap, les liens des e-mails et les images de partage)
# En local : laisse vide. En ligne : PUBLIC_URL=https://myrapfr.fr
PUBLIC_URL=

# Mettre à 1 quand le site est servi derrière Cloudflare Tunnel ou un reverse proxy HTTPS
TRUST_PROXY=0
BEHIND_TLS_PROXY=0

# Production : active HSTS et la mise en cache longue
NODE_ENV=development

# Mentions légales (obligatoires avant la mise en ligne)
OWNER_NAME=
OWNER_ADDRESS=
HOST_INFO=
CONTACT_EMAIL=contact@myrapfr.fr

# Récupération automatique des pochettes et photos au démarrage (mettre 0 pour désactiver)
AUTO_FETCH=1

# E-mails (confirmation d'adresse, mot de passe oublié). Sans ces lignes, ils s'affichent dans la console.
# Brevo (gratuit jusqu'à 300 e-mails par jour) : Paramètres → SMTP et API → onglet SMTP.
# Vérifie la configuration avec : npm run mail:test -- ton-adresse@exemple.fr
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyRapFr <contact@myrapfr.fr>

# Import d'historique depuis Last.fm (facultatif). Crée une clé gratuite sur https://www.last.fm/api/account/create
LASTFM_API_KEY=
